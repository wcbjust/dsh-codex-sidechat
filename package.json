{
  "name": "dsh-codex-sidechat",
  "version": "0.1.0",
  "description": "Codex 风格的 DeepSeek Harness 原生侧边聊天：独立上下文、共享工具、退出后清理。",
  "type": "module",
  "license": "MIT",
  "main": "./src/host.mjs",
  "exports": {
    ".": "./src/host.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "install.ps1",
    "install.cmd",
    "VERIFICATION.md",
    "build.mjs",
    "scripts/check-package.mjs",
    "PUBLISHING.md",
    "CHANGELOG.md",
    "PACKAGING-VERIFICATION.md",
    "verification-evidence.json"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm run build && npm test && npm run check:package",
    "prepack": "npm run build && npm run check:package",
    "release:pack": "node scripts/package-release.mjs",
    "repository:set": "node scripts/configure-repository.mjs",
    "index:generate": "node scripts/create-index.mjs"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "codex",
    "side-chat",
    "temporary-chat",
    "sidebar"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wcbjust/dsh-codex-sidechat.git"
  },
  "homepage": "https://github.com/wcbjust/dsh-codex-sidechat#readme",
  "bugs": {
    "url": "https://github.com/wcbjust/dsh-codex-sidechat/issues"
  }
}
